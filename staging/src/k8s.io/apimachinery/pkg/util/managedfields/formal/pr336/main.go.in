package main

import (
	"context"
	"fmt"
	"os"
	"sigs.k8s.io/structured-merge-diff/v7/formalbridge"
)

func main() {
	if len(os.Args) != 3 {
		panic("expected model and corpus paths")
	}
	data, err := os.ReadFile(os.Args[2])
	if err != nil {
		panic(err)
	}
	corpus, err := bridge.ReadCorpus(data)
	if err != nil {
		panic(err)
	}
	for i := range corpus.Cases {
		c := &corpus.Cases[i]
		c.Semantics = "predrag"
		if os.Getenv("SSA_PR336_BASE") == "1" {
			c.Semantics = "current"
		}
		for j := range c.Steps {
			step := &c.Steps[j]
			if os.Getenv("SSA_PR336_BASE") == "1" && step.GoExpect != nil {
				step.Expect = step.GoExpect
			}
			step.GoExpect = nil
			step.Difference = ""
			step.DifferenceKind = ""
		}
	}
	summary, err := bridge.Compare(context.Background(), os.Args[1], corpus.Cases)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	fmt.Printf("Pinned upstream comparison: %d cases / %d transitions, exact objects, ownership and errors.\n", summary.Cases, summary.Steps)
	if err := bridge.CompareNumericCodecCounterexamples(context.Background(), os.Args[1]); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	fmt.Println("Pinned upstream numeric FieldsV1: round-trip, false-conflict and forced ownership-loss witnesses agree with Go.")
}
