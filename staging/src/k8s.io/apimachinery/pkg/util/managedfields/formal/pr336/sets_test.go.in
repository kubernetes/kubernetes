package fieldpath

import (
	"bytes"
	"context"
	"encoding/json"
	"fmt"
	"os"
	"os/exec"
	"reflect"
	"testing"
	"time"

	"sigs.k8s.io/structured-merge-diff/v6/value"
)

type ssaFormalSetTree struct {
	Members  []int    `json:"members"`
	Children [][2]any `json:"children"`
}

func TestSSAFormalRecursiveDifference(t *testing.T) { testSSAFormalSets(t, false) }
func TestSSAFormalRootResetFilter(t *testing.T)     { testSSAFormalSets(t, true) }

func testSSAFormalSets(t *testing.T, reset bool) {
	domain := []PathElement{
		FieldNameElement("spec"), FieldNameElement("status"), KeyElementByFields("name", "db"),
		ValueElement(value.NewValueInterface("member")), IndexElement(0), IndexElement(1),
		KeyElementByFields("id", int64(9007199254740993)),
		KeyElementByFields("id", float64(9007199254740992)),
		FieldNameElement("metadata"),
	}
	serialized := map[string]int{}
	for rank, element := range domain {
		token, err := SerializePathElement(element)
		if err != nil {
			t.Fatal(err)
		}
		if _, duplicate := serialized[token]; duplicate {
			t.Fatalf("non-exact rank domain: %s", token)
		}
		serialized[token] = rank
	}
	rank := func(element PathElement) int {
		token, err := SerializePathElement(element)
		if err != nil {
			t.Fatal(err)
		}
		result, found := serialized[token]
		if !found {
			t.Fatalf("unknown exact path token: %s", token)
		}
		return result
	}
	var tree func(*Set) ssaFormalSetTree
	tree = func(set *Set) ssaFormalSetTree {
		result := ssaFormalSetTree{Members: []int{}, Children: [][2]any{}}
		set.Members.Iterate(func(element PathElement) { result.Members = append(result.Members, rank(element)) })
		for _, child := range set.Children.members {
			result.Children = append(result.Children, [2]any{rank(child.pathElement), tree(child.set)})
		}
		return result
	}
	exactPaths := func(set *Set) [][]int {
		result := [][]int{}
		set.Iterate(func(path Path) {
			encoded := []int{}
			for _, element := range path {
				encoded = append(encoded, rank(element))
			}
			result = append(result, encoded)
		})
		return result
	}
	less := make([][]bool, len(domain))
	for a := range domain {
		less[a] = make([]bool, len(domain))
		for b := range domain {
			less[a][b] = domain[a].Less(domain[b])
		}
	}
	if less[6][7] || less[7][6] {
		t.Fatal("numeric collision control no longer compares equal in both directions")
	}
	paths := [][]int{{0}, {0, 1}, {0, 2, 1}, {1, 3, 4}, {2, 5, 0, 1}, {4, 1}}
	if reset {
		paths = [][]int{{0}, {0, 1}, {0, 2, 1}, {1, 3, 4}, {8, 5, 0, 1}, {8, 1}}
	}
	sets := make([]*Set, 1<<len(paths))
	for mask := range sets {
		sets[mask] = NewSet()
		for index := len(paths) - 1; index >= 0; index-- {
			if mask&(1<<index) == 0 {
				continue
			}
			path := Path{}
			for _, key := range paths[index] {
				path = append(path, domain[key])
			}
			sets[mask].Insert(path)
		}
	}
	pairs := [][2]ssaFormalSetTree{}
	actual := [][][]int{}
	compare := func(left, right *Set) {
		beforeLeft, beforeRight := tree(left), tree(right)
		difference := left.Difference(right)
		if reset {
			difference = NewExcludeSetFilter(right).Filter(left)
		}
		leftPaths := map[string]bool{}
		for _, path := range exactPaths(left) {
			leftPaths[fmt.Sprint(path)] = true
		}
		observed := exactPaths(difference)
		if reset {
			blocked := map[int]bool{}
			for _, root := range beforeRight.Members {
				blocked[root] = true
			}
			wanted := [][]int{}
			for _, path := range exactPaths(left) {
				if !blocked[path[0]] {
					wanted = append(wanted, path)
				}
			}
			for _, path := range observed {
				if blocked[path[0]] {
					t.Fatalf("reset filter retained an excluded prefix: %v", path)
				}
			}
			if !reflect.DeepEqual(observed, wanted) {
				t.Fatalf("reset filter lost an independent prefix: got=%v want=%v", observed, wanted)
			}
		}
		for _, path := range observed {
			if !leftPaths[fmt.Sprint(path)] {
				t.Fatalf("recursive Difference invented an exact left path: %v; left=%v right=%v", path, beforeLeft, beforeRight)
			}
		}
		if !reflect.DeepEqual(beforeLeft, tree(left)) || !reflect.DeepEqual(beforeRight, tree(right)) {
			t.Fatal("recursive Difference mutated its inputs")
		}
		pairs = append(pairs, [2]ssaFormalSetTree{beforeLeft, beforeRight})
		actual = append(actual, observed)
	}
	rightSets := sets
	if reset {
		rightSets = make([]*Set, 8)
		for mask := range rightSets {
			rightSets[mask] = NewSet()
			for bit, label := range []int{0, 1, 8} {
				if mask&(1<<bit) != 0 {
					rightSets[mask].Insert(Path{domain[label]})
				}
			}
		}
	}
	for _, left := range sets {
		for _, right := range rightSets {
			compare(left, right)
		}
	}

	// Raw structure avoids Insert merging comparator-equal numeric representatives before the operation.
	low := &Set{Children: SetNodeMap{members: []setNode{{pathElement: domain[6], set: NewSet(Path{domain[0]}, Path{domain[1]})}}}}
	high := &Set{Children: SetNodeMap{members: []setNode{{pathElement: domain[7], set: NewSet(Path{domain[0]})}}}}
	longPath := Path{}
	for index := 0; index < 64; index++ {
		longPath = append(longPath, domain[index%2])
	}
	deep := NewSet(longPath)
	if reset {
		mixed := &Set{Children: SetNodeMap{members: []setNode{{pathElement: domain[0], set: low}, {pathElement: domain[1], set: high}}}}
		compare(mixed, NewSet(Path{domain[0]}))
		compare(mixed, NewSet(Path{domain[1]}))
		compare(mixed, NewSet(Path{domain[8]}))
		compare(&Set{Children: SetNodeMap{members: []setNode{{pathElement: domain[0], set: NewSet()}}}}, NewSet(Path{domain[0]}))
		compare(deep, NewSet(Path{domain[0]}))
		compare(deep, NewSet(Path{domain[1]}))
	} else {
		compare(low, high)
		compare(high, low)
		compare(&Set{Children: SetNodeMap{members: []setNode{{pathElement: domain[0], set: NewSet()}}}}, NewSet())
		compare(deep, deep)
		compare(deep, NewSet(Path{domain[0], domain[1]}))
		compare(NewSet(Path{domain[0], domain[1]}), deep)
	}

	input, err := json.Marshal(struct {
		Less  [][]bool              `json:"less"`
		Pairs [][2]ssaFormalSetTree `json:"pairs"`
	}{less, pairs})
	if err != nil {
		t.Fatal(err)
	}
	model := os.Getenv("SSA_SET_MODEL")
	if model == "" {
		t.Fatal("set SSA_SET_MODEL to the built ssa-model executable")
	}
	ctx, cancel := context.WithTimeout(context.Background(), time.Minute)
	defer cancel()
	mode := "--set-difference"
	if reset {
		mode = "--root-reset-filter"
	}
	command := exec.CommandContext(ctx, model, mode, "-")
	command.Stdin = bytes.NewReader(input)
	var stderr bytes.Buffer
	command.Stderr = &stderr
	output, err := command.Output()
	if err != nil {
		t.Fatalf("source set model failed: %v: %s", err, stderr.String())
	}
	var expected [][][]int
	if err := json.Unmarshal(output, &expected); err != nil {
		t.Fatal(err)
	}
	if len(expected) != len(actual) {
		t.Fatalf("recursive source/Go result count differs: %d/%d", len(expected), len(actual))
	}
	if !reflect.DeepEqual(expected, actual) {
		for index := range actual {
			if !reflect.DeepEqual(expected[index], actual[index]) {
				t.Fatalf("recursive source/Go mismatch at pair %d: source=%v Go=%v", index, expected[index], actual[index])
			}
		}
	}
	t.Logf("%d %s pairs matched source/Go; exact numeric tokens, direct/child overlap, empty nodes and depth 64", len(pairs), mode)
}
