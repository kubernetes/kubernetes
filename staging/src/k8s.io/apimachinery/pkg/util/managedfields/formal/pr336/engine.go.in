package bridge

import (
	"bytes"
	_ "embed"
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"sort"

	"sigs.k8s.io/structured-merge-diff/v7/fieldpath"
	"sigs.k8s.io/structured-merge-diff/v7/merge"
	"sigs.k8s.io/structured-merge-diff/v7/typed"
)

//go:embed schema.yaml
var schemaYAML string

type identityConverter struct{}

func (identityConverter) Convert(object *typed.TypedValue, _ fieldpath.APIVersion) (*typed.TypedValue, error) {
	return object, nil
}
func (identityConverter) IsMissingVersionError(error) bool { return false }

type goEngine struct {
	updater *merge.Updater
	live    *typed.TypedValue
	fields  fieldpath.ManagedFields
	schema  *structuralSchema
	typ     typed.ParseableType
}

func newGoEngine(cases ...Case) (*goEngine, error) {
	c := Case{}
	if len(cases) > 0 {
		c = cases[0]
	}
	sc, err := schemaFor(c)
	if err != nil {
		return nil, err
	}
	text := sc.legacy
	if os.Getenv("SSA_PR336_BASE") != "1" {
		data, err := json.Marshal(sc.document)
		if err != nil {
			return nil, err
		}
		text = string(data)
	}
	parser, err := typed.NewParser(typed.YAMLObject(text))
	if err != nil {
		return nil, err
	}
	typ := parser.Type(sc.root)
	live, err := typ.FromUnstructured(envelope(map[string]any{}))
	if err != nil {
		return nil, err
	}
	updater := (&merge.UpdaterBuilder{Converter: identityConverter{}}).BuildUpdater()
	return &goEngine{updater, live, fieldpath.ManagedFields{}, sc, typ}, nil
}
func (e *goEngine) step(step Step) (Snapshot, error) {
	config, err := e.typ.FromUnstructured(envelope(step.Apply))
	if err != nil {
		return Snapshot{}, err
	}
	working := e.fields.Copy()
	manager := step.Manager
	var object *typed.TypedValue
	var fields fieldpath.ManagedFields
	if step.Operation == "update" {
		manager += "@update"
		object, fields, err = e.updater.Update(e.live, config, "v1", working, manager)
	} else {
		object, fields, err = e.updater.Apply(e.live, config, "v1", working, manager, step.Force)
	}
	errorName := ""
	if err != nil {
		var conflicts merge.Conflicts
		if !errors.As(err, &conflicts) {
			return Snapshot{}, err
		}
		errorName = "conflict"
	} else {
		if object != nil {
			e.live = object
		}
		e.fields = fields
	}
	out := Snapshot{Error: errorName, Owners: map[string][]string{}}
	liveObject, ok := e.live.AsValue().Unstructured().(map[string]any)
	if !ok {
		return out, fmt.Errorf("upstream result lost the API object envelope")
	}
	objectValue := map[string]any{}
	for name, value := range liveObject {
		if name != "apiVersion" && name != "kind" {
			objectValue[name] = value
		}
	}
	flat, err := e.schema.flatten(objectValue, nil)
	if err != nil {
		return out, err
	}
	out.Cells, err = cellMap(flat.cells)
	if err != nil {
		return out, err
	}
	for manager, versioned := range e.fields {
		// Exercise the exact field-set wire encoding on the pinned upstream implementation.
		data, err := versioned.Set().ToJSON()
		if err != nil {
			return out, err
		}
		decoded := fieldpath.NewSet()
		if err := decoded.FromJSON(bytes.NewReader(data)); err != nil {
			return out, err
		}
		if !decoded.Equals(versioned.Set()) {
			return out, fmt.Errorf("FieldsV1 changed %s ownership", manager)
		}
		var invalid error
		decoded.Iterate(func(p fieldpath.Path) {
			if isKeyField(p) {
				return
			}
			if len(p) > 0 && p[0].FieldName != nil && (*p[0].FieldName == "apiVersion" || *p[0].FieldName == "kind") {
				return
			}
			key := p.String()
			if _, ok := out.Cells[key]; !ok {
				invalid = fmt.Errorf("dangling upstream claim %s by %s", key, manager)
				return
			}
			out.Owners[manager] = append(out.Owners[manager], key)
		})
		if invalid != nil {
			return out, invalid
		}
		sort.Strings(out.Owners[manager])
	}
	return out, nil
}
func isKeyField(p fieldpath.Path) bool {
	if len(p) < 2 || p[len(p)-2].Key == nil || p[len(p)-1].FieldName == nil {
		return false
	}
	for _, key := range *p[len(p)-2].Key {
		if key.Name == *p[len(p)-1].FieldName {
			return true
		}
	}
	return false
}

func envelope(object map[string]any) map[string]any {
	out := map[string]any{"apiVersion": "formal.ssa/v1", "kind": "Document"}
	for name, value := range object {
		out[name] = value
	}
	return out
}
